{
  "name": "dsh-netease-card-adapter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "description": "Drive the DSH netease music card through its DOM, so the conversation tool and the remote hub do not depend on the vendor plugin's internals.",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
